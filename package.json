{
  "name": "pokeh5",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Idle Pokemon RPG for mobile, built with Phaser 3 and packaged with Capacitor",
  "scripts": {
    "assets": "node scripts/fetch-assets.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "shot": "node scripts/screenshot.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "@capacitor/preferences": "^7.0.2",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "playwright": "^1.62.1",
    "sharp": "^0.34.4",
    "terser": "^5.44.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
  }
}
