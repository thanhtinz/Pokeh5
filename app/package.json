{
  "name": "pokeh5-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Capacitor wrapper that packages the Egret web client as a native Android/iOS app",
  "scripts": {
    "prepare:client": "node scripts/prepare-client.mjs",
    "verify": "node scripts/verify-client.mjs",
    "cap:add:android": "cap add android",
    "sync": "npm run prepare:client && cap sync",
    "open:android": "cap open android",
    "build:apk": "npm run sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.3",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "playwright": "^1.62.1"
  }
}
