-- Least-privilege grants for the portal user.
--
-- Compose creates MYSQL_USER with full rights on the database. The portal only
-- ever reads accounts and writes gift claims and mail, so those rights are
-- narrowed here. The release ran the whole portal as MySQL root with the
-- password committed to source.
--
-- Copy to `04-grants.sql` and replace the user name if you changed MYSQL_USER.

REVOKE ALL PRIVILEGES ON `pokemon`.* FROM 'pokemon_portal'@'%';

GRANT SELECT                          ON `pokemon`.`t_account`               TO 'pokemon_portal'@'%';
GRANT SELECT                          ON `pokemon`.`x_listgift`              TO 'pokemon_portal'@'%';
GRANT SELECT                          ON `pokemon`.`list_items`              TO 'pokemon_portal'@'%';
GRANT SELECT, INSERT                  ON `pokemon`.`x_keygift`               TO 'pokemon_portal'@'%';
GRANT INSERT                          ON `pokemon`.`t_player_mails`          TO 'pokemon_portal'@'%';
GRANT SELECT, INSERT, UPDATE          ON `pokemon`.`x_portal_admin`          TO 'pokemon_portal'@'%';
GRANT SELECT, INSERT, UPDATE, DELETE  ON `pokemon`.`x_portal_login_attempt`  TO 'pokemon_portal'@'%';
GRANT SELECT, INSERT                  ON `pokemon`.`x_portal_audit`          TO 'pokemon_portal'@'%';

FLUSH PRIVILEGES;
