# Copy to deploy/.env and fill in. This file is git-ignored.

# --- database -------------------------------------------------------------
# Generate real values, e.g. `openssl rand -base64 24`.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=pokemon
MYSQL_USER=pokemon_portal
MYSQL_PASSWORD=change-me-portal
# Host-side port. The game services connect here; keep it on loopback.
MYSQL_PORT=3306

# --- web ------------------------------------------------------------------
HTTP_PORT=8080
# Where the "Play" button points. Leave as /game/ when serving the client from
# this stack; set a full URL if the client lives elsewhere.
PLAY_URL=/game/
# Turn on once the site is behind HTTPS, so session cookies get the Secure flag.
SECURE_COOKIES=false

# --- game client ----------------------------------------------------------
# Path to the extracted Egret client, i.e. XJLserver/client/Pokemon
CLIENT_DIR=../../XJLserver/client/Pokemon

# --- top-up contact shown on /naptien.php --------------------------------
SUPPORT_ZALO=
SUPPORT_BANK=
