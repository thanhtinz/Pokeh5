RewriteEngine On
RewriteBase /

RewriteRule ^maps/code/benhvien-(.*).xml$ maps/code/benhvien.xml [L]
RewriteRule ^maps/code/shop-(.*).xml$ maps/code/shop.xml [L]
RewriteRule ^maps/code/nha-(.*).xml$ maps/code/nha.xml [L]

RewriteRule ^screen/images/game/close.png$ style/images/game/close.png [L]

RewriteRule ^game.json$ data.php?ducnghia [L]
RewriteRule ^(.*).json$ data/index.php [L]

RewriteCond %{HTTP_HOST} ^sc1.lol$ [OR]
RewriteCond %{HTTP_HOST} ^www.sc1.lol$
RewriteRule ^(.*)$ _blog/$1

# Runtime state, local credentials and the developer tooling are not web
# content. Serving storage/ would hand out the realtime event log, and
# config.local.php holds the database password.
RedirectMatch 404 ^/(storage|app|scripts|tests|db)(/|$)
RedirectMatch 404 ^/config\.local\.php$

# Buffering a Server-Sent Events response holds every message until the
# connection closes, which stalls chat and the player list.
<IfModule mod_env.c>
    SetEnvIf Request_URI "^/realtime/stream\.php$" no-gzip=1
</IfModule>
